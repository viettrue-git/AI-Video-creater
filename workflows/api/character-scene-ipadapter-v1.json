{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "IN_Checkpoint" },
    "inputs": { "ckpt_name": "sd_xl_base_1.0.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "IN_PositivePrompt" },
    "inputs": { "text": "", "clip": ["1", 1] }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "IN_NegativePrompt" },
    "inputs": { "text": "", "clip": ["1", 1] }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "IN_Size" },
    "inputs": { "width": 768, "height": 1344, "batch_size": 1 }
  },
  "10": {
    "class_type": "LoadImage",
    "_meta": { "title": "IN_RefImage" },
    "inputs": { "image": "char_main_front.png" }
  },
  "11": {
    "class_type": "PrepImageForClipVision",
    "_meta": { "title": "PrepRef" },
    "inputs": { "image": ["10", 0], "interpolation": "LANCZOS", "crop_position": "pad", "sharpening": 0.0 }
  },
  "12": {
    "class_type": "IPAdapterUnifiedLoader",
    "_meta": { "title": "IPALoader" },
    "inputs": { "model": ["1", 0], "preset": "PLUS (high strength)" }
  },
  "13": {
    "class_type": "IPAdapterAdvanced",
    "_meta": { "title": "IN_IPAdapter" },
    "inputs": {
      "model": ["12", 0],
      "ipadapter": ["12", 1],
      "image": ["11", 0],
      "weight": 0.7,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0.0,
      "end_at": 1.0,
      "embeds_scaling": "V only"
    }
  },
  "20": {
    "class_type": "KSampler",
    "_meta": { "title": "IN_Sampler" },
    "inputs": {
      "model": ["13", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": 111111,
      "steps": 25,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 1.0
    }
  },
  "21": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" },
    "inputs": { "samples": ["20", 0], "vae": ["1", 2] }
  },
  "22": {
    "class_type": "SaveImage",
    "_meta": { "title": "OUT_Image" },
    "inputs": { "images": ["21", 0], "filename_prefix": "tests/img" }
  }
}
